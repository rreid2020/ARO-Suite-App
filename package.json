{
  "name": "aro-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env.local src/server/listen.ts",
    "build": "prisma generate && tsc -b && vite build",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.12",
    "@clerk/react": "^6.14.7",
    "@hono/node-server": "^2.1.1",
    "@prisma/client": "^6.19.3",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
